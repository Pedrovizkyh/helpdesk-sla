NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk
REDIS_URL=redis://localhost:6379

# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# Endereço do front, usado nos links dos e-mails
WEB_URL=http://localhost:5173

# Worker da fila e job de SLA no mesmo processo da API
RUN_WORKER=true
RUN_SCHEDULER=true

# E-mail (local: Mailpit em http://localhost:8025)
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Helpdesk SLA <no-reply@helpdesk.test>"
# Se preenchido, TODO e-mail vai para este endereço (obrigatório em produção com e-mail ligado)
EMAIL_REDIRECT_TO=
